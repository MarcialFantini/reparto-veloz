---
import Layout from '../layouts/Layout.astro';
import { CUSTOMERS, DRIVERS, PRODUCTS } from '../data/catalog';
import { PLACES } from '../data/map';
import { STATES } from '../data/orders';
import { STATE_META } from '../lib/status';
---

<Layout title="Pedidos · Logística Andina (demo)" view="pedidos" page="orders">
  <div class="wrap">
    <div class="ops-head">
      <div>
        <p class="eyebrow">Gestión · Todos los pedidos del día</p>
        <h1 class="ops-title display">Pedidos</h1>
        <p class="ops-lead">Buscá, filtrá y exportá. La tabla se actualiza sola con el reloj; los cambios que hagas se ven en todas las vistas.</p>
      </div>
      <div class="orders__actions">
        <button type="button" class="btn" data-new-order>
          <svg viewBox="0 0 20 20" width="16" height="16" aria-hidden="true"><path d="M10 4v12M4 10h12" stroke="currentColor" stroke-width="2.4" stroke-linecap="round"></path></svg>
          Nuevo pedido
        </button>
        <button type="button" class="btn btn--ghost" data-export>
          <svg viewBox="0 0 20 20" width="16" height="16" aria-hidden="true"><path d="M10 3v10m-4-4 4 4 4-4M4 16h12" stroke="currentColor" stroke-width="2" fill="none" stroke-linecap="round" stroke-linejoin="round"></path></svg>
          Exportar CSV
        </button>
      </div>
    </div>

    <div class="filters panel" role="search">
      <label class="field filters__search">
        Buscar
        <input type="search" placeholder="Número, cliente, barrio o chofer" data-filter-q autocomplete="off" />
      </label>
      <label class="field">
        Barrio
        <select data-filter-place>
          <option value="">Todos</option>
          {PLACES.map((p) => <option value={p.id}>{p.name}</option>)}
        </select>
      </label>
      <label class="field">
        Chofer
        <select data-filter-driver>
          <option value="">Todos</option>
          {DRIVERS.map((d) => <option value={d.id}>{d.name}</option>)}
        </select>
      </label>
      <div class="chips" role="group" aria-label="Filtrar por estado">
        <button type="button" class="fchip" data-filter-state="" aria-pressed="true">Todos <span data-chip-count="all"></span></button>
        {
          STATES.map((s) => (
            <button type="button" class="fchip" data-state={s} data-filter-state={s} aria-pressed="false">
              {STATE_META[s].label} <span data-chip-count={s} />
            </button>
          ))
        }
        <button type="button" class="fchip fchip--alert" data-filter-state="incidencia" aria-pressed="false">Con incidencia <span data-chip-count="incidencia"></span></button>
      </div>
    </div>

    <p class="orders__summary" aria-live="polite" data-orders-summary>Cargando pedidos…</p>

    <div class="table-wrap panel">
      <table class="otable">
        <caption class="sr-only">Pedidos del día. Elegí una fila para ver el detalle.</caption>
        <thead>
          <tr>
            <th scope="col"><button type="button" data-sort="id">Pedido</button></th>
            <th scope="col"><button type="button" data-sort="customer">Cliente</button></th>
            <th scope="col"><button type="button" data-sort="place">Barrio</button></th>
            <th scope="col"><button type="button" data-sort="driver">Chofer</button></th>
            <th scope="col"><button type="button" data-sort="state">Estado</button></th>
            <th scope="col" class="num"><button type="button" data-sort="parcels">Bultos</button></th>
            <th scope="col" class="num"><button type="button" data-sort="received">Recibido</button></th>
            <th scope="col" class="num"><button type="button" data-sort="eta">Llegada</button></th>
          </tr>
        </thead>
        <tbody data-orders-body>
          {
            Array.from({ length: 8 }, () => (
              <tr class="skeleton-only">
                <td colspan="8">
                  <span class="skeleton" style="height: 18px" />
                </td>
              </tr>
            ))
          }
        </tbody>
      </table>
    </div>
  </div>

  <dialog class="drawer" data-drawer aria-labelledby="drawer-title">
    <div class="drawer__box" data-drawer-body></div>
  </dialog>

  <dialog class="drawer drawer--form" data-new-dialog aria-labelledby="new-title">
    <form class="drawer__box neworder" data-new-form>
      <div class="drawer__head">
        <h2 id="new-title" class="display drawer__title">Nuevo pedido</h2>
        <button type="button" class="iconbtn" data-close aria-label="Cerrar">
          <svg viewBox="0 0 20 20" width="16" height="16" aria-hidden="true"><path d="M5 5l10 10M15 5 5 15" stroke="currentColor" stroke-width="2.2" stroke-linecap="round"></path></svg>
        </button>
      </div>
      <p class="neworder__lead">Entra como <strong>Recibido</strong> a la hora simulada actual y sigue su recorrido como cualquier otro pedido.</p>
      <label class="field">
        Cliente
        <select name="customer" required>
          {CUSTOMERS.map((c) => <option value={c}>{c}</option>)}
        </select>
      </label>
      <label class="field">
        Barrio de entrega
        <select name="place" required>
          {PLACES.map((p) => <option value={p.id}>{p.name}</option>)}
        </select>
      </label>
      <fieldset class="neworder__items">
        <legend class="field">Productos (elegí al menos uno)</legend>
        {
          PRODUCTS.slice(0, 10).map((p, i) => (
            <div class="neworder__item">
              <label>
                <input type="checkbox" name="sku" value={p.sku} checked={i < 3} /> {p.name}
              </label>
              <input type="number" name={`qty-${p.sku}`} min="1" max="99" value={String(2 + (i % 4))} aria-label={`Cantidad de ${p.name}`} />
            </div>
          ))
        }
      </fieldset>
      <p class="neworder__error" data-new-error role="alert"></p>
      <div class="drawer__actions">
        <button type="submit" class="btn">Crear pedido</button>
        <button type="button" class="btn btn--ghost" data-close>Cancelar</button>
      </div>
    </form>
  </dialog>

  <template data-driver-options>
    {DRIVERS.map((d) => <option value={d.id}>{d.name} · {d.truck}</option>)}
  </template>
</Layout>

<style is:global>
  .orders__actions {
    display: flex;
    flex-wrap: wrap;
    gap: 8px;
  }

  .filters {
    display: grid;
    gap: 12px;
    margin-top: 22px;
  }

  .chips {
    display: flex;
    flex-wrap: wrap;
    gap: 6px;
  }

  .fchip {
    display: inline-flex;
    align-items: center;
    gap: 6px;
    min-height: 36px;
    padding: 0 12px;
    border-radius: 999px;
    border: 2px solid var(--ink);
    background: var(--card);
    font-weight: 700;
    font-size: 0.8125rem;
  }

  .fchip[data-state]::before {
    content: '';
    width: 9px;
    height: 9px;
    border-radius: 50%;
    background: var(--state);
  }

  .fchip[aria-pressed='true'] {
    background: var(--ink);
    color: var(--paper);
  }

  .fchip span {
    font-weight: 800;
    opacity: 0.7;
  }

  .orders__summary {
    margin: 16px 2px 8px;
    font-weight: 700;
    color: var(--ink-2);
    font-size: 0.875rem;
  }

  .table-wrap {
    padding: 0;
    overflow: hidden;
  }

  .otable {
    width: 100%;
    border-collapse: collapse;
    font-size: 0.875rem;
  }

  .otable thead {
    display: none;
  }

  .otable tbody tr {
    display: grid;
    grid-template-columns: 1fr auto;
    gap: 2px 10px;
    padding: 12px 14px;
    border-bottom: 1px solid var(--line);
    cursor: pointer;
    transition: background 150ms;
  }

  .otable tbody tr:hover {
    background: var(--paper-2);
  }

  .otable td {
    padding: 0;
  }

  .otable .c-id {
    font-family: var(--display);
    font-size: 1.4rem;
    font-weight: 600;
  }

  .otable .c-id button {
    padding: 0;
    border: 0;
    background: none;
    font: inherit;
    text-align: left;
  }

  .otable .c-state {
    justify-self: end;
    align-self: center;
  }

  .otable .c-customer {
    grid-column: 1 / -1;
    font-weight: 800;
  }

  .otable .c-place,
  .otable .c-driver,
  .otable .c-parcels,
  .otable .c-received {
    display: none;
  }

  .otable .c-eta {
    grid-column: 1 / -1;
    color: var(--muted);
    font-size: 0.8125rem;
  }

  .otable .c-eta strong {
    color: var(--ink);
  }

  .otable tr.is-new {
    animation: row-flash 1.6s ease-out;
  }

  @keyframes row-flash {
    from {
      background: color-mix(in srgb, var(--st-preparando) 55%, transparent);
    }
  }

  .otable .mobile-meta {
    display: inline;
  }

  .num {
    text-align: right;
    font-variant-numeric: tabular-nums;
  }

  /* Drawer (order detail and new order) */
  .drawer {
    width: min(520px, 100vw);
    max-width: 100vw;
    height: 100dvh;
    max-height: 100dvh;
    margin: 0 0 0 auto;
    padding: 0;
    border: 0;
    background: transparent;
    color: var(--ink);
  }

  .drawer::backdrop {
    background: rgb(22 19 15 / 0.45);
  }

  .drawer__box {
    display: grid;
    align-content: start;
    gap: 16px;
    height: 100%;
    padding: 20px;
    overflow-y: auto;
    background: var(--card);
    border-left: 2px solid var(--ink);
  }

  .drawer__head {
    display: flex;
    align-items: start;
    justify-content: space-between;
    gap: 12px;
  }

  .drawer__title {
    font-size: 2.6rem;
  }

  .drawer__actions {
    display: flex;
    flex-wrap: wrap;
    gap: 8px;
  }

  .dsteps {
    display: grid;
    gap: 0;
    margin: 0;
    padding: 0;
    list-style: none;
  }

  .dsteps li {
    display: grid;
    grid-template-columns: 18px 1fr auto;
    gap: 10px;
    align-items: center;
    padding: 7px 0;
    font-size: 0.875rem;
    color: var(--muted);
  }

  .dsteps li::before {
    content: '';
    width: 14px;
    height: 14px;
    border-radius: 50%;
    border: 2px solid var(--line);
  }

  .dsteps li.is-done {
    color: var(--ink);
  }

  .dsteps li.is-done::before {
    background: var(--state);
    border-color: var(--ink);
  }

  .dsteps li.is-now {
    font-weight: 800;
  }

  .dbox {
    padding: 14px;
    border-radius: 14px;
    border: 2px solid var(--ink);
  }

  .dbox--alert {
    background: #fbe9e7;
    border-color: #b3261e;
  }

  .dbox__title {
    font-weight: 800;
  }

  .dlist {
    display: grid;
    gap: 4px;
    margin: 6px 0 0;
    padding: 0;
    list-style: none;
    font-size: 0.875rem;
  }

  .dlist li {
    display: flex;
    justify-content: space-between;
    gap: 10px;
  }

  .neworder__lead {
    color: var(--ink-2);
    font-size: 0.9375rem;
  }

  .neworder__items {
    display: grid;
    gap: 6px;
    margin: 0;
    padding: 0;
    border: 0;
  }

  .neworder__item {
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 10px;
    padding: 6px 10px;
    border-radius: 10px;
    background: var(--paper);
    font-size: 0.875rem;
    font-weight: 600;
  }

  .neworder__item input[type='checkbox'] {
    width: 18px;
    height: 18px;
    margin-right: 6px;
    vertical-align: -3px;
    accent-color: var(--ink);
  }

  .neworder__item input[type='number'] {
    width: 64px;
    min-height: 36px;
    padding: 0 8px;
    border: 2px solid var(--ink);
    border-radius: 8px;
    font-weight: 700;
  }

  .neworder__error {
    min-height: 1.2em;
    color: #b3261e;
    font-weight: 700;
    font-size: 0.875rem;
  }

  @media (min-width: 720px) {
    .filters {
      grid-template-columns: 2fr 1fr 1fr;
    }
    .chips {
      grid-column: 1 / -1;
    }
  }

  @media (min-width: 980px) {
    .otable thead {
      display: table-header-group;
    }
    .otable tbody tr {
      display: table-row;
    }
    .otable th,
    .otable td {
      padding: 10px 12px;
      text-align: left;
      border-bottom: 1px solid var(--line);
    }
    .otable th.num,
    .otable td.num {
      text-align: right;
    }
    .otable th button {
      padding: 0;
      border: 0;
      background: none;
      font-weight: 800;
      font-size: 0.8125rem;
      color: var(--ink-2);
    }
    .otable th[aria-sort] button::after {
      content: ' ↑';
    }
    .otable th[aria-sort='descending'] button::after {
      content: ' ↓';
    }
    .otable .c-place,
    .otable .c-driver,
    .otable .c-parcels,
    .otable .c-received {
      display: table-cell;
    }
    .otable .c-eta {
      color: var(--ink);
      font-size: 0.875rem;
    }
    .otable .mobile-meta {
      display: none;
    }
    .otable .c-id {
      font-size: 1.25rem;
    }
  }
</style>
