---
import Layout from '../layouts/Layout.astro';
import { ORDERS, SIM_START, STATES } from '../data/orders';
import { STATE_META, stateAt, clock } from '../lib/status';

// One sample per state at the start of the simulation, plus a second one on the road.
const samples = STATES.map((s) => ORDERS.find((o) => stateAt(o, SIM_START) === s)).filter(
  (o): o is (typeof ORDERS)[number] => Boolean(o),
);
const extra = ORDERS.filter((o) => stateAt(o, SIM_START) === 'en-camino')[1];
if (extra) samples.splice(4, 0, extra);
---

<Layout title="Seguí tu pedido · Logística Andina (demo)" view="cliente" page="entry">
  <section class="entry wrap" aria-labelledby="entry-title">
    <p class="eyebrow">Seguimiento de pedidos · Córdoba</p>
    <h1 id="entry-title" class="entry__title display">
      <span>¿Dónde está</span>
      <span>tu pedido?</span>
    </h1>
    <p class="entry__lead">
      Escribí el número que figura en tu remito y mirá el viaje completo: desde que armamos la caja hasta que llega a tu puerta.
    </p>

    <form class="lookup" data-lookup novalidate>
      <label class="lookup__label" for="order-number">Número de pedido</label>
      <div class="lookup__row">
        <input
          id="order-number"
          name="order"
          class="lookup__input display"
          type="text"
          inputmode="text"
          autocomplete="off"
          autocapitalize="characters"
          spellcheck="false"
          placeholder={samples[0]?.id ?? 'LA-2040'}
          aria-describedby="lookup-hint lookup-error"
          required
        />
        <button class="btn lookup__btn" type="submit">
          Seguir pedido
          <svg viewBox="0 0 20 20" width="18" height="18" aria-hidden="true"><path d="M4 10h11m-4-5 5 5-5 5" stroke="currentColor" stroke-width="2.2" fill="none" stroke-linecap="round" stroke-linejoin="round"></path></svg>
        </button>
      </div>
      <p id="lookup-hint" class="lookup__hint">Formato LA-0000. También podés escribir solo los números.</p>
      <p id="lookup-error" class="lookup__error" data-lookup-error role="alert"></p>
    </form>

    <ol class="journey" aria-label="Etapas de un pedido">
      {
        STATES.map((s, i) => (
          <li class="journey__step" data-state={s}>
            <span class="journey__n display">{String(i + 1).padStart(2, '0')}</span>
            <span class="journey__label">{STATE_META[s].label}</span>
          </li>
        ))
      }
    </ol>
  </section>

  <section class="samples wrap" aria-labelledby="samples-title">
    <div class="samples__head">
      <h2 id="samples-title" class="section-title">Pedidos de ejemplo</h2>
      <p class="samples__note">Estado a las <span data-sim-clock-inline>{clock(SIM_START)}</span> (hora simulada)</p>
    </div>
    <ul class="samples__list">
      {
        samples.map((o) => {
          const s = stateAt(o, SIM_START) ?? 'recibido';
          return (
            <li>
              <a class="sample" href={`/pedido/${o.id}`} data-sample={o.id} data-state={s}>
                <span class="sample__id display" style={`view-transition-name: order-${o.id}`}>
                  {o.id}
                </span>
                <span class="sample__meta">
                  <span class="sample__customer">{o.customer}</span>
                  <span class="sample__place">{o.placeName}</span>
                </span>
                <span class="chip sample__chip" data-sample-state>
                  {STATE_META[s].label}
                </span>
              </a>
            </li>
          );
        })
      }
    </ul>
  </section>
</Layout>

<style>
  .entry {
    padding-top: 28px;
  }

  .entry__title {
    display: grid;
    margin-top: 10px;
    font-size: clamp(3.4rem, 17vw, 8.5rem);
  }

  .entry__title span:last-child {
    color: var(--st-en-camino);
  }

  .entry__lead {
    max-width: 52ch;
    margin-top: 18px;
    color: var(--ink-2);
    font-size: 1.0625rem;
  }

  .lookup {
    margin-top: 28px;
    padding: 18px;
    border-radius: var(--radius);
    background: var(--card);
    border: 2px solid var(--ink);
    box-shadow: 6px 6px 0 var(--ink);
    max-width: 640px;
  }

  .lookup__label {
    font-weight: 800;
    font-size: 0.875rem;
  }

  .lookup__row {
    display: flex;
    flex-direction: column;
    gap: 14px;
    margin-top: 6px;
  }

  .lookup__input {
    width: 100%;
    min-width: 0;
    padding: 4px 0 6px;
    border: 0;
    border-bottom: 3px solid var(--ink);
    background: transparent;
    font-size: clamp(2.6rem, 13vw, 4rem);
    border-radius: 0;
  }

  .lookup__input::placeholder {
    color: var(--line);
  }

  .lookup__input:focus-visible {
    outline: none;
    border-bottom-color: var(--st-recibido);
  }

  .lookup__btn {
    min-height: 52px;
  }

  .lookup__hint {
    margin-top: 10px;
    font-size: 0.8125rem;
    color: var(--muted);
  }

  .lookup__error {
    min-height: 1.4em;
    margin-top: 4px;
    font-weight: 700;
    font-size: 0.875rem;
    color: #b3261e;
  }

  .journey {
    display: grid;
    grid-template-columns: repeat(5, minmax(0, 1fr));
    margin: 36px 0 0;
    padding: 0;
    list-style: none;
    border-radius: var(--radius);
    overflow: hidden;
  }

  .journey__step {
    display: grid;
    align-content: space-between;
    gap: 22px;
    min-height: 150px;
    padding: 10px 8px;
    background: var(--state);
    color: var(--on-state);
  }

  .journey__n {
    font-size: 1.9rem;
  }

  .journey__label {
    font-weight: 800;
    font-size: 0.8125rem;
    line-height: 1.15;
    writing-mode: vertical-rl;
    transform: rotate(180deg);
    justify-self: start;
  }

  .samples {
    margin-top: 48px;
  }

  .samples__head {
    display: flex;
    flex-wrap: wrap;
    align-items: baseline;
    justify-content: space-between;
    gap: 6px 16px;
  }

  .samples__note {
    color: var(--muted);
    font-size: 0.875rem;
  }

  .samples__list {
    display: grid;
    gap: 10px;
    margin: 18px 0 0;
    padding: 0;
    list-style: none;
  }

  .sample {
    display: grid;
    grid-template-columns: auto 1fr;
    grid-template-areas: 'id chip' 'meta meta';
    align-items: center;
    gap: 6px 14px;
    padding: 14px 16px;
    border-radius: var(--radius);
    background: var(--card);
    border: 1px solid var(--line);
    border-left: 10px solid var(--state);
    text-decoration: none;
    transition: transform 200ms var(--ease-out);
  }

  .sample:hover {
    transform: translateX(4px);
  }

  .sample__id {
    grid-area: id;
    font-size: 2.2rem;
    width: fit-content;
  }

  .sample__chip {
    grid-area: chip;
    justify-self: end;
  }

  .sample__meta {
    grid-area: meta;
    display: flex;
    flex-wrap: wrap;
    gap: 2px 10px;
    font-size: 0.875rem;
  }

  .sample__customer {
    font-weight: 800;
  }

  .sample__place {
    color: var(--muted);
  }

  @media (min-width: 720px) {
    .entry {
      padding-top: 56px;
    }
    .lookup__row {
      flex-direction: row;
      align-items: flex-end;
    }
    .lookup__btn {
      flex: none;
    }
    .journey__step {
      min-height: 150px;
      padding: 16px;
    }
    .journey__n {
      font-size: 3rem;
    }
    .journey__label {
      font-size: 0.9375rem;
      writing-mode: horizontal-tb;
      transform: none;
    }
    .samples__list {
      grid-template-columns: repeat(2, 1fr);
    }
    .sample {
      grid-template-columns: auto 1fr auto;
      grid-template-areas: 'id meta chip';
    }
    .sample__meta {
      flex-direction: column;
    }
  }

  @media (min-width: 1080px) {
    .samples__list {
      grid-template-columns: repeat(3, 1fr);
    }
    .sample {
      grid-template-columns: auto 1fr;
      grid-template-areas: 'id chip' 'meta meta';
    }
    .sample__meta {
      flex-direction: row;
    }
  }
</style>
