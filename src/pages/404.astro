---
import Layout from "../layouts/Layout.astro";
import ConsultaForm from "../components/ConsultaForm.tsx";
---

<Layout
  title="Pedido no encontrado · Reparto Veloz"
  description="No encontramos el código de pedido que ingresaste. Probá de nuevo o contactanos por WhatsApp."
  noindex={true}
  currentPath="/404"
>
  <section class="mx-auto max-w-2xl px-4 pb-16 pt-12 sm:px-6 sm:pb-20 sm:pt-16">
    <div class="rounded-2xl border border-gris bg-papel-soft p-6 sm:p-8">
      <div
        class="grid h-12 w-12 place-items-center rounded-2xl bg-state-demorado-bg text-state-demorado-text ring-1 ring-state-demorado-ring"
        aria-hidden="true"
      >
        <svg
          xmlns="http://www.w3.org/2000/svg"
          viewBox="0 0 24 24"
          fill="none"
          stroke="currentColor"
          stroke-width="1.6"
          stroke-linecap="round"
          stroke-linejoin="round"
          class="h-6 w-6"
        >
          <circle cx="11" cy="11" r="8"></circle>
          <line x1="21" y1="21" x2="16.65" y2="16.65"></line>
        </svg>
      </div>

      <h1 class="mt-5 text-[28px] font-semibold tracking-tight text-ink sm:text-[32px]">
        No encontramos ese pedido
      </h1>
      <p class="mt-3 text-[15px] leading-relaxed text-ink-soft">
        El código que ingresaste no figura en el sistema. Puede ser un error de
        tipeo, o que el envío aún no haya sido registrado. Si acabás de recibir
        el comprobante, esperá unos minutos y volvé a consultar.
      </p>

      <div class="mt-6 rounded-xl border border-gris bg-papel p-5">
        <p class="font-mono text-[10px] uppercase tracking-[0.18em] text-ink-muted">
          Probá de nuevo
        </p>
        <div class="mt-3">
          <ConsultaForm client:load />
        </div>
      </div>

      <div class="mt-6 flex flex-wrap items-center gap-3 text-[13px]">
        <a
          href="https://wa.me/5491147771100?text=Hola%2C%20no%20encuentro%20mi%20pedido."
          target="_blank"
          rel="noopener noreferrer"
          class="inline-flex items-center gap-2 rounded-xl bg-delivery px-5 py-3 text-[13px] font-semibold uppercase tracking-[0.18em] text-white ring-1 ring-delivery transition-colors hover:bg-accent-deep"
        >
          Contactar soporte por WhatsApp
          <span aria-hidden="true">→</span>
        </a>
        <a href="/" class="text-ink-soft hover:text-accent-deep">
          ← Volver al inicio
        </a>
      </div>
    </div>
  </section>
</Layout>
