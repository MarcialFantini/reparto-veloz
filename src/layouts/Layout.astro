---
import { ClientRouter } from 'astro:transitions';
import '@fontsource-variable/oswald';
import '@fontsource-variable/manrope';
import '../styles/global.css';
import oswaldLatin from '@fontsource-variable/oswald/files/oswald-latin-wght-normal.woff2?url';
import manropeLatin from '@fontsource-variable/manrope/files/manrope-latin-wght-normal.woff2?url';
import { SIM_START } from '../data/orders';
import { clock } from '../lib/status';
import { VIEWS, type ViewId } from '../lib/views';

interface Props {
  title: string;
  description?: string;
  view: ViewId;
  page: string;
  state?: string;
}

const {
  title,
  description = 'Demo de un sistema de gestión de transporte para un mayorista ficticio de Córdoba. Marca y datos ficticios.',
  view,
  page,
  state,
} = Astro.props;
---

<!doctype html>
<html lang="es-AR">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <meta name="description" content={description} />
    <meta name="theme-color" content="#f3efe6" />
    <meta name="robots" content="noindex" />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:image" content="/poster.jpg" />
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
    <link rel="preload" href={oswaldLatin} as="font" type="font/woff2" crossorigin />
    <link rel="preload" href={manropeLatin} as="font" type="font/woff2" crossorigin />
    <title>{title}</title>
    <ClientRouter fallback="swap" />
    <script is:inline>
      if (new URLSearchParams(location.search).has('showcase')) document.documentElement.classList.add('is-showcase');
    </script>
  </head>
  <body data-page={page} data-view={view} data-state={state}>
    <a class="skip" href="#contenido">Saltar al contenido</a>
    <header class="topbar">
      <div class="wrap topbar__inner">
        <div class="topbar__brand">
          <a class="brand" href="/" aria-label="Logística Andina, inicio">
            <svg class="brand__mark" viewBox="0 0 32 32" aria-hidden="true">
              <path d="M4 11 16 5l12 6v11l-12 6-12-6Z" fill="var(--ink)"></path>
              <path d="M4 11l12 6 12-6M16 17v11" stroke="var(--paper)" stroke-width="2" fill="none"></path>
            </svg>
            <span class="brand__name">Logística Andina</span>
          </a>
          <span class="demo-mark" title="Marca y datos ficticios">Demo</span>
        </div>

        <div class="live" role="group" aria-label="Simulación en vivo">
          <span class="live__pill" data-live-pill>
            <span class="live__dot" aria-hidden="true"></span>
            <span data-live-label>En vivo</span>
          </span>
          <span class="live__clock display" data-sim-clock aria-label="Hora simulada">{clock(SIM_START)}</span>
          <button type="button" class="iconbtn" data-pause aria-label="Pausar la simulación" aria-pressed="false" title="Pausar (P)">
            <span class="iconbtn__icon" data-icon-pause><svg viewBox="0 0 20 20" width="18" height="18" aria-hidden="true"><path d="M6 4h3v12H6zM11 4h3v12h-3z" fill="currentColor"></path></svg></span>
            <span class="iconbtn__icon" data-icon-play hidden><svg viewBox="0 0 20 20" width="18" height="18" aria-hidden="true"><path d="M6 4l10 6-10 6z" fill="currentColor"></path></svg></span>
          </button>
          <div class="speed" role="group" aria-label="Velocidad">
            {
              [1, 4, 10].map((s) => (
                <button type="button" class="speed__opt" data-speed={s} aria-pressed={s === 1 ? 'true' : 'false'}>
                  {s}x
                </button>
              ))
            }
          </div>
          <button type="button" class="btn live__advance" data-advance title="Adelantar 1 hora (H)">+1 h<span class="sr-only">: adelantar una hora</span></button>
        </div>

        <div class="topbar__tools">
          <button type="button" class="iconbtn search-btn" data-open-palette aria-label="Buscar y comandos (Ctrl+K)" title="Buscar (Ctrl+K)">
            <svg viewBox="0 0 20 20" width="18" height="18" aria-hidden="true"><path d="M9 3a6 6 0 1 1 0 12A6 6 0 0 1 9 3Zm4.5 10.5L17 17" stroke="currentColor" stroke-width="2" fill="none" stroke-linecap="round"></path></svg>
            <span class="search-btn__label">Buscar</span>
            <kbd class="search-btn__kbd">Ctrl K</kbd>
          </button>
          <div class="notif">
            <button type="button" class="iconbtn" data-bell aria-haspopup="dialog" aria-expanded="false" aria-controls="notif-panel" aria-label="Notificaciones">
              <svg viewBox="0 0 20 20" width="19" height="19" aria-hidden="true"><path d="M10 2.5a5 5 0 0 1 5 5v3.5l1.5 2.5h-13L5 11V7.5a5 5 0 0 1 5-5ZM8 16a2 2 0 0 0 4 0" stroke="currentColor" stroke-width="1.8" fill="none" stroke-linejoin="round"></path></svg>
              <span class="notif__badge" data-bell-badge hidden>0</span>
            </button>
            <div class="notif__panel" id="notif-panel" role="dialog" aria-label="Centro de notificaciones" data-notif-panel hidden>
              <div class="notif__head">
                <p class="notif__title display">Notificaciones</p>
                <button type="button" class="linkbtn" data-mark-read>Marcar todo como leído</button>
              </div>
              <ol class="notif__list" data-notif-list></ol>
            </div>
          </div>
        </div>
      </div>

      <nav class="views" aria-label="Vistas">
        <div class="wrap views__inner">
          {
            VIEWS.map((v) => (
              <a href={v.href} class:list={['views__tab', { 'is-active': v.id === view }]} aria-current={v.id === view ? 'page' : undefined} data-view-tab={v.id}>
                {v.id === view && <span class="views__thumb" style="view-transition-name: view-thumb" />}
                <svg viewBox="0 0 20 20" width="16" height="16" aria-hidden="true">
                  <path d={v.icon} />
                </svg>
                <span>{v.label}</span>
                {v.id === 'incidencias' && <span class="views__count" data-incident-count hidden />}
              </a>
            ))
          }
        </div>
      </nav>
    </header>

    <div class="toasts" aria-live="polite" aria-atomic="false" transition:persist="toasts" data-toasts></div>

    <main id="contenido" tabindex="-1" transition:animate="fade">
      <slot />
    </main>

    <footer class="foot">
      <div class="wrap foot__row">
        <p>
          Demo de portfolio. Logística Andina, sus pedidos, clientes y choferes son ficticios. El tiempo es simulado: a 1x, 1 segundo real equivale a 1 minuto.
          <button type="button" class="linkbtn" data-open-help>Atajos de teclado</button>
        </p>
        <button type="button" class="btn btn--ghost" data-reset>Reiniciar demo</button>
      </div>
    </footer>

    <dialog class="palette" data-palette aria-label="Buscar pedidos, choferes y acciones">
      <div class="palette__box">
        <div class="palette__field">
          <svg viewBox="0 0 20 20" width="20" height="20" aria-hidden="true"><path d="M9 3a6 6 0 1 1 0 12A6 6 0 0 1 9 3Zm4.5 10.5L17 17" stroke="currentColor" stroke-width="2" fill="none" stroke-linecap="round"></path></svg>
          <input
            class="palette__input"
            type="text"
            placeholder="Buscá un pedido, un chofer o una acción"
            aria-label="Buscar"
            role="combobox"
            aria-expanded="true"
            aria-controls="palette-list"
            aria-autocomplete="list"
            autocomplete="off"
            spellcheck="false"
            data-palette-input
          />
          <kbd>Esc</kbd>
        </div>
        <ul class="palette__list" id="palette-list" role="listbox" data-palette-list></ul>
        <p class="palette__foot"><kbd>↑</kbd><kbd>↓</kbd> para moverte · <kbd>Enter</kbd> para elegir · <kbd>Esc</kbd> para cerrar</p>
      </div>
    </dialog>

    <dialog class="help" data-help aria-labelledby="help-title">
      <div class="help__box">
        <h2 id="help-title" class="display">Atajos de teclado</h2>
        <dl class="help__list">
          <div><dt><kbd>Ctrl</kbd> <kbd>K</kbd> o <kbd>/</kbd></dt><dd>Buscar pedidos, choferes y acciones</dd></div>
          <div><dt><kbd>P</kbd></dt><dd>Pausar o reanudar la simulación</dd></div>
          <div><dt><kbd>1</kbd> <kbd>2</kbd> <kbd>3</kbd></dt><dd>Velocidad 1x, 4x o 10x</dd></div>
          <div><dt><kbd>H</kbd></dt><dd>Adelantar 1 hora</dd></div>
          <div><dt><kbd>N</kbd></dt><dd>Nuevo pedido</dd></div>
          <div><dt><kbd>G</kbd> y luego <kbd>C</kbd> <kbd>F</kbd> <kbd>P</kbd> <kbd>D</kbd> <kbd>R</kbd> <kbd>M</kbd> <kbd>I</kbd></dt><dd>Ir a Cliente, Flota, Pedidos, Depósito, Repartidores, Métricas o Incidencias</dd></div>
          <div><dt><kbd>?</kbd></dt><dd>Mostrar esta ayuda</dd></div>
        </dl>
        <form method="dialog"><button class="btn">Entendido</button></form>
      </div>
    </dialog>

    <script>
      import '../scripts/app';
    </script>
  </body>
</html>

<style>
  .skip {
    position: absolute;
    left: 8px;
    top: -60px;
    z-index: 100;
    padding: 10px 14px;
    background: var(--ink);
    color: var(--paper);
    border-radius: 8px;
    font-weight: 700;
  }
  .skip:focus {
    top: 8px;
  }

  .topbar {
    position: sticky;
    top: 0;
    z-index: 30;
    background: var(--paper);
    border-bottom: 1px solid var(--line);
    view-transition-name: topbar;
  }

  .topbar__inner {
    display: grid;
    grid-template-columns: 1fr auto;
    grid-template-areas: 'brand tools' 'live live';
    align-items: center;
    gap: 8px 12px;
    padding-block: 10px 8px;
  }

  .topbar__brand {
    grid-area: brand;
    display: flex;
    align-items: center;
    gap: 10px;
    min-width: 0;
  }

  .brand {
    display: inline-flex;
    align-items: center;
    gap: 8px;
    text-decoration: none;
    font-weight: 800;
    letter-spacing: -0.01em;
    white-space: nowrap;
  }

  .brand__mark {
    width: 26px;
    height: 26px;
  }

  .demo-mark {
    display: inline-flex;
    align-items: center;
    padding: 3px 9px 2px;
    border: 2px solid var(--ink);
    border-radius: 6px;
    font-family: var(--display);
    font-weight: 600;
    font-size: 0.85rem;
    letter-spacing: 0.08em;
    text-transform: uppercase;
    transform: rotate(-3deg);
    background: var(--st-preparando);
  }

  .live {
    grid-area: live;
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 6px;
  }

  .live__pill {
    display: inline-flex;
    align-items: center;
    gap: 6px;
    padding: 4px 9px;
    border-radius: 999px;
    background: var(--st-en-camino);
    color: #fff;
    font-size: 0.6875rem;
    font-weight: 800;
    letter-spacing: 0.06em;
    text-transform: uppercase;
    white-space: nowrap;
  }

  .live__pill.is-paused {
    background: var(--ink-2);
  }

  .live__dot {
    width: 7px;
    height: 7px;
    border-radius: 50%;
    background: #fff;
    animation: live-pulse 1.4s ease-in-out infinite;
  }

  .live__pill.is-paused .live__dot {
    animation: none;
    opacity: 0.5;
  }

  @keyframes live-pulse {
    50% {
      opacity: 0.25;
      transform: scale(0.7);
    }
  }

  .live__clock {
    font-size: 1.5rem;
    min-width: 3.3ch;
  }

  @media (min-width: 400px) {
    .live {
      gap: 8px;
    }
  }

  .iconbtn {
    position: relative;
    display: inline-grid;
    place-items: center;
    min-width: 40px;
    height: 40px;
    padding: 0 10px;
    border: 2px solid var(--ink);
    border-radius: 999px;
    background: var(--card);
    color: var(--ink);
  }

  .iconbtn[aria-pressed='true'] {
    background: var(--ink);
    color: var(--paper);
  }

  .speed {
    display: inline-flex;
    border: 2px solid var(--ink);
    border-radius: 999px;
    overflow: hidden;
    background: var(--card);
  }

  .speed__opt {
    min-width: 36px;
    height: 36px;
    padding: 0 8px;
    border: 0;
    background: transparent;
    font-weight: 800;
    font-size: 0.8125rem;
  }

  .speed__opt + .speed__opt {
    border-left: 1.5px solid var(--line);
  }

  .speed__opt[aria-pressed='true'] {
    background: var(--ink);
    color: var(--paper);
  }

  .speed__opt:focus-visible {
    outline-offset: -4px;
  }

  .live__advance {
    min-height: 40px;
    padding: 0 12px;
    font-size: 0.8125rem;
    white-space: nowrap;
  }

  .topbar__tools {
    grid-area: tools;
    display: flex;
    align-items: center;
    gap: 8px;
  }

  .search-btn {
    display: inline-flex;
    gap: 8px;
  }

  .search-btn__label,
  .search-btn__kbd {
    display: none;
  }

  kbd {
    display: inline-block;
    padding: 1px 6px;
    border: 1.5px solid var(--line);
    border-bottom-width: 3px;
    border-radius: 6px;
    background: var(--card);
    font-family: var(--body);
    font-size: 0.75rem;
    font-weight: 800;
    color: var(--ink-2);
  }

  .notif {
    position: relative;
  }

  .notif__badge {
    position: absolute;
    top: -6px;
    right: -6px;
    min-width: 20px;
    height: 20px;
    padding: 0 5px;
    border-radius: 999px;
    background: var(--st-en-camino);
    color: #fff;
    font-size: 0.6875rem;
    font-weight: 800;
    line-height: 20px;
    text-align: center;
    border: 2px solid var(--paper);
  }

  .notif__panel {
    position: absolute;
    right: 0;
    top: calc(100% + 10px);
    z-index: 40;
    width: min(380px, calc(100vw - 24px));
    max-height: min(70vh, 520px);
    display: flex;
    flex-direction: column;
    border-radius: 16px;
    background: var(--card);
    border: 2px solid var(--ink);
    box-shadow: 8px 8px 0 var(--ink);
    overflow: hidden;
  }

  .notif__head {
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 10px;
    padding: 12px 14px;
    border-bottom: 1px solid var(--line);
  }

  .notif__title {
    font-size: 1.4rem;
  }

  .notif__list {
    margin: 0;
    padding: 6px;
    list-style: none;
    overflow-y: auto;
    overscroll-behavior: contain;
  }

  .views {
    border-top: 1px solid var(--line);
  }

  .views__inner {
    display: flex;
    gap: 4px;
    overflow-x: auto;
    scrollbar-width: none;
    padding-block: 6px;
  }

  .views__inner::-webkit-scrollbar {
    display: none;
  }

  .views__tab {
    position: relative;
    display: inline-flex;
    align-items: center;
    gap: 7px;
    flex: none;
    min-height: 38px;
    padding: 0 12px;
    border-radius: 999px;
    text-decoration: none;
    font-weight: 700;
    font-size: 0.875rem;
    color: var(--ink-2);
  }

  .views__tab svg,
  .views__tab span {
    position: relative;
  }

  .views__tab svg {
    fill: none;
    stroke: currentColor;
    stroke-width: 1.7;
    stroke-linejoin: round;
    stroke-linecap: round;
  }

  .views__tab:hover {
    background: var(--paper-2);
  }

  .views__tab.is-active {
    color: var(--paper);
  }

  .views__thumb {
    position: absolute !important;
    inset: 0;
    border-radius: 999px;
    background: var(--ink);
  }

  .views__count {
    min-width: 20px;
    padding: 0 6px;
    border-radius: 999px;
    background: var(--st-despachado);
    color: var(--ink);
    font-size: 0.75rem;
    font-weight: 800;
    text-align: center;
  }

  .toasts {
    position: sticky;
    top: 150px;
    z-index: 25;
    height: 0;
    overflow: visible;
  }

  main {
    display: block;
    outline: none;
  }

  .foot {
    margin-top: 64px;
    border-top: 1px solid var(--line);
    color: var(--muted);
    font-size: 0.875rem;
  }

  .foot__row {
    display: flex;
    flex-direction: column;
    gap: 12px;
    padding-block: 24px 40px;
  }

  .linkbtn {
    padding: 0;
    border: 0;
    background: none;
    font-weight: 800;
    font-size: 0.8125rem;
    color: var(--ink);
    text-decoration: underline;
    text-underline-offset: 3px;
  }

  @media (min-width: 720px) {
    .search-btn__label,
    .search-btn__kbd {
      display: inline-block;
    }
    .search-btn {
      padding: 0 8px 0 12px;
    }
    .foot__row {
      flex-direction: row;
      align-items: center;
      justify-content: space-between;
    }
  }

  @media (min-width: 1100px) {
    .topbar__inner {
      grid-template-columns: auto 1fr auto;
      grid-template-areas: 'brand live tools';
      padding-block: 10px;
    }
    .live {
      justify-content: center;
    }
    .toasts {
      top: 122px;
    }
  }
</style>
