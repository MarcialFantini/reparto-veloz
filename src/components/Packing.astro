---
import type { Order } from '../data/orders';
import type { ItemShape } from '../data/catalog';

interface Props {
  order: Order;
}

const { order } = Astro.props;

const ICONS: Record<ItemShape, string> = {
  sack: 'M8 6h12l-1 3 3 5v9a2 2 0 0 1-2 2H8a2 2 0 0 1-2-2v-9l3-5z',
  bottle: 'M12 3h4v4l3 4v13a1 1 0 0 1-1 1h-8a1 1 0 0 1-1-1V11l3-4z',
  box: 'M5 9l9-4 9 4v11l-9 4-9-4z',
  can: 'M7 6c0-1.7 3.1-2 7-2s7 .3 7 2v16c0 1.7-3.1 2-7 2s-7-.3-7-2z',
  jar: 'M9 3h10v3H9zM8 8h12a2 2 0 0 1 2 2v12a2 2 0 0 1-2 2H8a2 2 0 0 1-2-2V10a2 2 0 0 1 2-2z',
  pack: 'M6 5h16l-1 4H7zM7 9h14v15H7z',
};
---

<section class="scene packing" aria-labelledby="packing-title" data-packing>
  <h2 id="packing-title" class="section-title">Contenido del pedido</h2>
  <p class="packing__lead">Tocá cada producto para guardarlo en la caja. Cuando estén todos, la caja se cierra.</p>

  <div class="packing__layout">
    <div class="stage3d" aria-hidden="true">
      <div class="box3d" data-box>
        <div class="box3d__face box3d__face--bottom"></div>
        <div class="box3d__face box3d__face--back"></div>
        <div class="box3d__face box3d__face--left"></div>
        <div class="box3d__face box3d__face--right"></div>
        <div class="box3d__level" data-box-fill><div class="box3d__fill"></div></div>
        <div class="box3d__face box3d__face--front">
          <span class="box3d__print">Logística Andina</span>
          <span class="box3d__id display">{order.id}</span>
          <span class="box3d__fragile">Este lado arriba ↑</span>
        </div>
        <div class="box3d__hinge box3d__hinge--front"><div class="box3d__flap" data-flap="front"></div></div>
        <div class="box3d__hinge box3d__hinge--back"><div class="box3d__flap box3d__flap--back" data-flap="back"></div></div>
        <div class="box3d__tape"><span data-tape></span></div>
      </div>
      <div class="stage3d__shadow"></div>
    </div>

    <div class="packing__side">
      <p class="packing__count" aria-live="polite">
        <span class="display" data-pack-count>0</span>
        <span>de {order.items.length} productos en la caja</span>
      </p>
      <ul class="items">
        {
          order.items.map((item) => (
            <li>
              <button type="button" class="item" data-sku={item.sku} aria-pressed="false">
                <svg class="item__icon" viewBox="0 0 28 28" aria-hidden="true" data-shape={item.shape}>
                  <path d={ICONS[item.shape]} />
                </svg>
                <span class="item__text">
                  <span class="item__name">{item.name}</span>
                  <span class="item__qty">
                    {item.qty} {item.unit} · {item.sku}
                  </span>
                </span>
                <span class="item__state" data-item-state>
                  Empacar
                </span>
              </button>
            </li>
          ))
        }
      </ul>
      <div class="packing__actions">
        <button type="button" class="btn" data-pack-all>Empacar todo</button>
        <button type="button" class="btn btn--ghost" data-pack-reset>Vaciar la caja</button>
      </div>
    </div>
  </div>
</section>

<style>
  .packing__lead {
    margin-top: 6px;
    color: var(--muted);
    font-size: 0.9375rem;
  }

  .packing__layout {
    display: grid;
    gap: 20px;
    margin-top: 18px;
  }

  /* ---------- CSS 3D box ---------- */
  .stage3d {
    --w: 168px;
    --h: 104px;
    --d: 128px;
    position: sticky;
    top: 118px;
    z-index: 2;
    height: 230px;
    border-radius: 20px;
    background: var(--st-preparando);
    border: 2px solid var(--ink);
    perspective: 900px;
    perspective-origin: 50% 20%;
    overflow: hidden;
  }

  .stage3d__shadow {
    position: absolute;
    left: 50%;
    bottom: 42px;
    width: 230px;
    height: 46px;
    margin-left: -115px;
    border-radius: 50%;
    background: rgb(22 19 15 / 0.22);
  }

  .box3d {
    position: absolute;
    left: 50%;
    top: 58%;
    width: 0;
    height: 0;
    z-index: 1;
    transform-style: preserve-3d;
    transform: rotateX(-24deg) rotateY(-34deg);
  }

  .box3d > * {
    position: absolute;
    backface-visibility: visible;
  }

  .box3d__face {
    border: 2px solid var(--ink);
  }

  .box3d__face--front,
  .box3d__face--back {
    width: var(--w);
    height: var(--h);
    margin: calc(var(--h) / -2) 0 0 calc(var(--w) / -2);
  }

  .box3d__face--front {
    display: grid;
    align-content: center;
    justify-items: center;
    gap: 2px;
    background: #cf9a57;
    transform: translateZ(calc(var(--d) / 2));
    color: var(--ink);
  }

  .box3d__face--back {
    background: #8d6334;
    transform: rotateY(180deg) translateZ(calc(var(--d) / 2));
  }

  .box3d__face--left,
  .box3d__face--right {
    width: var(--d);
    height: var(--h);
    margin: calc(var(--h) / -2) 0 0 calc(var(--d) / -2);
    background: #b78145;
  }

  .box3d__face--left {
    transform: rotateY(-90deg) translateZ(calc(var(--w) / 2));
  }

  .box3d__face--right {
    transform: rotateY(90deg) translateZ(calc(var(--w) / 2));
  }

  .box3d__face--bottom {
    width: var(--w);
    height: var(--d);
    margin: calc(var(--d) / -2) 0 0 calc(var(--w) / -2);
    background: #7a552b;
    transform: rotateX(-90deg) translateZ(calc(var(--h) / 2));
  }

  .box3d__fill {
    width: calc(var(--w) - 8px);
    height: calc(var(--d) - 8px);
    margin: calc((var(--d) - 8px) / -2) 0 0 calc((var(--w) - 8px) / -2);
    background:
      radial-gradient(circle at 25% 30%, var(--st-recibido) 0 9px, transparent 10px),
      radial-gradient(circle at 70% 60%, var(--st-en-camino) 0 11px, transparent 12px),
      radial-gradient(circle at 45% 75%, var(--st-entregado) 0 8px, transparent 9px),
      #efe4cc;
    border: 2px solid var(--ink);
    transform: rotateX(90deg);
  }

  .box3d__level,
  .box3d__hinge {
    width: 0;
    height: 0;
    transform-style: preserve-3d;
  }

  .box3d__level {
    transform: translateY(calc(var(--h) / 2 - 4px));
    opacity: 0;
  }

  .box3d__print {
    font-weight: 800;
    font-size: 0.6875rem;
    letter-spacing: 0.04em;
  }

  .box3d__id {
    font-size: 2.2rem;
  }

  .box3d__fragile {
    font-size: 0.625rem;
    font-weight: 800;
    padding: 1px 6px;
    border: 1.5px solid var(--ink);
  }

  .box3d__flap {
    position: absolute;
    width: var(--w);
    height: calc(var(--d) / 2);
    margin-left: calc(var(--w) / -2);
    background: #dcae6e;
    border: 2px solid var(--ink);
    transform-origin: 50% 0;
    transform: rotateX(150deg);
  }

  .box3d__hinge--front {
    transform: translate3d(0, calc(var(--h) / -2), calc(var(--d) / 2));
  }

  .box3d__hinge--back {
    transform: translate3d(0, calc(var(--h) / -2), calc(var(--d) / -2));
  }

  .box3d__flap--back {
    background: #c5904f;
    transform: rotateX(210deg);
  }

  .box3d__tape {
    width: 30px;
    height: calc(var(--d) + 10px);
    margin: calc((var(--d) + 10px) / -2) 0 0 -15px;
    transform: rotateX(90deg) translateZ(calc(var(--h) / 2 + 2px)) rotateZ(90deg);
  }

  .box3d__tape span {
    display: block;
    width: 100%;
    height: 100%;
    background: var(--ink);
    transform: scaleY(0);
    transform-origin: 50% 0;
  }

  /* ---------- Item list ---------- */
  .packing__count {
    display: flex;
    align-items: baseline;
    gap: 8px;
    font-weight: 700;
  }

  .packing__count .display {
    font-size: 2.8rem;
  }

  .items {
    display: grid;
    gap: 8px;
    margin: 12px 0 0;
    padding: 0;
    list-style: none;
  }

  .item {
    display: grid;
    grid-template-columns: 40px 1fr auto;
    align-items: center;
    gap: 12px;
    width: 100%;
    min-height: 60px;
    padding: 8px 12px;
    text-align: left;
    border: 2px solid var(--ink);
    border-radius: 12px;
    background: var(--card);
    transition: transform 160ms var(--ease-out), opacity 200ms;
  }

  .item:hover {
    transform: translateY(-2px);
  }

  .item:active {
    transform: scale(0.98);
  }

  .item__icon {
    width: 40px;
    height: 40px;
    padding: 5px;
    border-radius: 10px;
    background: var(--st-preparando);
    fill: var(--card);
    stroke: var(--ink);
    stroke-width: 1.8;
    stroke-linejoin: round;
  }

  .item__text {
    display: grid;
    min-width: 0;
  }

  .item__name {
    font-weight: 800;
    font-size: 0.9375rem;
    line-height: 1.25;
  }

  .item__qty {
    font-size: 0.8125rem;
    color: var(--muted);
  }

  .item__state {
    font-size: 0.75rem;
    font-weight: 800;
    padding: 4px 10px;
    border-radius: 999px;
    border: 1.5px solid var(--ink);
  }

  .item[aria-pressed='true'] {
    border-style: dashed;
    border-color: var(--line);
    background: transparent;
  }

  .item[aria-pressed='true'] .item__icon {
    opacity: 0.35;
  }

  .item[aria-pressed='true'] .item__state {
    background: var(--st-entregado);
    border-color: var(--st-entregado);
    color: #fff;
  }

  .packing__actions {
    display: flex;
    flex-wrap: wrap;
    gap: 10px;
    margin-top: 14px;
  }

  @media (max-width: 719px) {
    .stage3d {
      --w: 150px;
      --h: 92px;
      --d: 114px;
    }
    .stage3d__shadow {
      bottom: 30px;
    }
  }

  @media (min-width: 720px) {
    .stage3d {
      height: 270px;
    }
    .packing__layout {
      grid-template-columns: minmax(0, 1fr) minmax(0, 1fr);
      align-items: start;
    }
    .stage3d {
      position: sticky;
      top: 140px;
    }
  }

  @media (min-width: 980px) {
    .packing__layout {
      grid-template-columns: 1fr;
    }
    .stage3d {
      position: relative;
      top: 0;
    }
  }
</style>
